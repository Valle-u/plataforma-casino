{
  "name": "@casino/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle ORM schemas + client for control DB and tenant DBs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./control": {
      "types": "./dist/control/index.d.ts",
      "default": "./dist/control/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "db:setup:control": "tsx src/scripts/setup-control.ts",
    "db:gen:control": "drizzle-kit generate --config=drizzle.control.config.ts",
    "db:migrate:control": "drizzle-kit migrate --config=drizzle.control.config.ts",
    "db:studio:control": "drizzle-kit studio --config=drizzle.control.config.ts",
    "db:seed:control": "tsx src/scripts/seed-control.ts",
    "db:gen:tenant": "drizzle-kit generate --config=drizzle.tenant.config.ts",
    "db:studio:tenant": "drizzle-kit studio --config=drizzle.tenant.config.ts",
    "db:migrate:tenants": "tsx src/scripts/migrate-existing-tenants.ts",
    "db:backfill:player-hierarchy": "tsx src/scripts/backfill-player-hierarchy.ts",
    "db:seed:dev-tenant": "tsx src/scripts/seed-dev-tenant.ts",
    "db:seed:pilot": "tsx src/scripts/seed-pilot-tenant.ts",
    "db:list:tenants": "tsx src/scripts/list-tenants.ts",
    "db:reset:demo": "tsx src/scripts/reset-demo-tenant.ts",
    "db:verify:money": "tsx src/scripts/verify-money-clean.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5",
    "uuid": "^11.0.4"
  },
  "devDependencies": {
    "@casino/eslint-config": "workspace:*",
    "@casino/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
