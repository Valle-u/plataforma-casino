{
  "name": "@casino/games-jokers-jewels",
  "version": "0.0.0",
  "private": true,
  "description": "Joker's Jewels — primer slot propio de la plataforma. Math + spin logic + Monte Carlo simulator. Sin cliente acá — el cliente PixiJS vive en apps/games/jokers-jewels/ (Fase 2)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./simulator": {
      "types": "./src/simulator.ts",
      "default": "./src/simulator.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "tsx src/scripts/run-simulation.ts"
  },
  "dependencies": {
    "@casino/games-shared": "workspace:*"
  },
  "devDependencies": {
    "@casino/eslint-config": "workspace:*",
    "@casino/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
