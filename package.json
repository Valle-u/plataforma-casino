{
  "name": "plataforma-casino",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma de casino virtual multi-tenant white-label",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "e2e": "pnpm --filter @casino/e2e test",
    "e2e:headed": "pnpm --filter @casino/e2e test:headed",
    "e2e:ui": "pnpm --filter @casino/e2e test:ui",
    "e2e:install": "pnpm --filter @casino/e2e install:browsers",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
