# EditorConfig — http://editorconfig.org
# Asegura que cualquier editor (VSCode, JetBrains, Vim, etc.) respete las
# mismas convenciones de formateo. Las reglas se aplican automáticamente.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
