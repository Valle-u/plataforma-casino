{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@casino/web",
        "dev"
      ],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@casino/api",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "jokers-jewels",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@casino/games-jokers-jewels-client",
        "dev"
      ],
      "port": 4001,
      "autoPort": false
    },
    {
      "name": "web-sin-turbo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@casino/web",
        "exec",
        "next",
        "dev",
        "-p",
        "3002"
      ],
      "port": 3002,
      "autoPort": false
    },
    {
      "name": "api-crm",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set CRM_ENABLED=1&& pnpm --filter @casino/api dev"
      ],
      "port": 3000,
      "autoPort": false
    }
  ]
}
