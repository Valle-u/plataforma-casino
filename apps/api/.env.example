# =============================================================================
# Variables de entorno para apps/api
#
# Este archivo es la plantilla. Para usar:
#   1. Copiarlo como .env.local (no se sube a git)
#   2. Llenar los valores reales
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL — DB de control (ver docs/02-arquitectura.md §4)
# Reemplazá <password> por la que pusiste al instalar Postgres.
DATABASE_URL_CONTROL=postgresql://postgres:<password>@localhost:5432/platform_control

# PostgreSQL — Template de URL para DBs de tenant (usado por drizzle-kit
# para generar/aplicar migraciones a una DB de tenant específica).
# Sustituí <tenant_db> por el nombre real (ej: 'tenant_demo_casino') al usar.
DATABASE_URL_TENANT_TEMPLATE=postgresql://postgres:<password>@localhost:5432/<tenant_db>

# Redis (cache + queues) — corre local con redis-windows port
REDIS_URL=redis://localhost:6379

# Token simple para proteger endpoints administrativos en dev.
# Antes de auth completa (Fase 1.5+), endpoints como GET /tenants requieren
# este header X-Admin-Token. Generá un valor random largo para evitar leaks.
ADMIN_API_TOKEN=replace-with-random-32-char-string

# JWT — generamos los secrets reales en la fase de auth
JWT_ACCESS_SECRET=change-me-soon
JWT_REFRESH_SECRET=change-me-soon-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Logging
LOG_LEVEL=debug
