# =============================================================================
# Variables de entorno para apps/api
#
# Uso:
#   1. Copiar como .env.local (gitignoreado)
#   2. Llenar los valores reales
#
# Leyenda:
#   🔴 SECRETO — generar único por entorno, nunca commitear el valor real.
#   (opcional) — si no se setea, la feature degrada de forma conocida.
#
# Validación: al bootear, config/env.validation.ts EXIGE las vars marcadas
# como obligatorias abajo (DB + JWT) y falla rápido si faltan.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# DB de control (registro de tenants, super-admins). OBLIGATORIA.
DATABASE_URL_CONTROL=postgresql://postgres:<password>@localhost:5432/platform_control

# Template de URL para las DBs de tenant. OBLIGATORIA.
# DEBE contener el placeholder <tenant_db>, que se reemplaza por el nombre real
# (ej. 'tenant_demo_casino') al resolver cada tenant.
DATABASE_URL_TENANT_TEMPLATE=postgresql://postgres:<password>@localhost:5432/<tenant_db>

# Tamaño máximo del pool de conexiones (opcional; default 30 control / 10 tenant).
# DB_POOL_MAX=30

# ── Redis ── (opcional: sin REDIS_URL, cache y rate-limit caen a in-memory) ────
REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=casino:
# REDIS_DEFAULT_TTL_SECONDS=300

# ── JWT (auth) ───────────────────────────────────────────────────────────────
# 🔴 OBLIGATORIA. Generá un valor random largo: openssl rand -hex 64
# NO puede quedar en el placeholder 'change-me-soon' (el boot lo rechaza).
JWT_ACCESS_SECRET=replace-with-random-64-byte-hex-string
JWT_ACCESS_TTL=15m
# Nota: los refresh tokens son opacos (random + hash en DB); NO usan un secreto
# JWT, por eso no hay JWT_REFRESH_SECRET.

# ── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos del panel/web, separados por coma. En el VPS seteá acá el
# o los dominios reales. Si se deja vacío, cae a los dominios actuales de Vercel.
# CORS_ORIGINS=https://panel.tudominio.com,https://tudominio.com

# ── Proveedores de juego ─────────────────────────────────────────────────────
# 🔴 Token que valida los callbacks seamless de Palace. Sin esto, los callbacks
# se rechazan (imprescindible si operás Palace). El resto de la config de Palace
# y Forever (api_url, tokens, agent codes) vive POR TENANT en la DB de control.
PALACE_CALLBACK_TOKEN=

# ── Storage / uploads ────────────────────────────────────────────────────────
# Driver: 'local' (disco) | 'r2' | 'cloudflare-worker'. Default 'local'.
# ⚠️ En Docker/VPS 'local' se PIERDE en cada redeploy salvo volumen persistente.
# En prod: usar 'r2', o montar un volumen y setear STORAGE_PUBLIC_BASE_URL.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
#
# ⚠️ SOLO EL ORIGEN DE LA API, sin path. El driver le agrega `/storage/files/`
# solo. Este ejemplo decia `https://api.tudominio.com/storage/files` y seguirlo
# daba URLs con el path duplicado (`/storage/files/storage/files/<key>`), que dan
# 404 sin decir por que. `docs/STORAGE.md` lo tenia bien; este archivo no.
#
# ⚠️ SIN ESTA VARIABLE el default es `http://localhost:3000`, o sea que TODOS los
# adjuntos del chat quedan apuntando a la maquina de quien mira. Falla en
# silencio: una imagen no carga y un `<audio>` no suena, sin ningun error visible.
# STORAGE_PUBLIC_BASE_URL=https://api-staging.miamihub.vip
# Cloudflare R2 (si STORAGE_DRIVER=r2):
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=          # 🔴
# R2_SECRET_ACCESS_KEY=      # 🔴
# R2_BUCKET=casino-uploads
# R2_PUBLIC_BASE_URL=https://uploads.tudominio.com

# ── Web Push — ⚠️ REMOVIDO, no configurar ────────────────────────────────────
# La feature se sacó el 2026-08-13 (commit `58c7123`): funcionaba mal y se
# retomará más adelante. Ya no hay endpoints, provider ni dependencia; el código
# NO lee estas variables. La tabla `push_subscriptions` y el valor `web_push`
# del enum quedaron dormidos a propósito, para reactivar sin migración.
#
# Setearlas hoy no hace nada. Si aparece una notificación de ese canal se marca
# `failed` con motivo `web_push_disabled`, para no quedar en loop.
#
# ⚠️ En producción (Dokploy) las tres siguen cargadas y son configuración muerta.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=

# ── SMS / Twilio (opcional: sin esto, SMS desactivado) ───────────────────────
# TWILIO_ACCOUNT_SID=        # 🔴
# TWILIO_AUTH_TOKEN=         # 🔴
# TWILIO_FROM_NUMBER=+549...
# TWILIO_API_BASE_URL=https://api.twilio.com

# ── Observabilidad (opcional) ────────────────────────────────────────────────
# Si SENTRY_DSN no está seteado, Sentry queda deshabilitado (no-op).
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# LOG_ALL_EXCEPTIONS=false
# Nota: hoy el nivel de log lo controla NODE_ENV (LOG_LEVEL aún no se lee).

# ── Flags de operación (opcionales) ──────────────────────────────────────────
# RATE_LIMIT_ENABLED=true
# TWO_FA_POLICY_ENABLED=false

# ── Crons ── (patrón: *_ENABLED=false para apagar, *_CRON para reprogramar) ────
# Cada job tiene un default prod-safe. Ejemplos (ver el código para la lista
# completa: leagues, bonuses, ledger-recon, fraud-scan, users-inactivity,
# notifications-dispatcher, movement-alerts, game-provider-*, retentions).
# LEAGUES_RECOMPUTE_ENABLED=true
# LEAGUES_RECOMPUTE_CRON=*/5 * * * *
# BONUSES_EXPIRE_ENABLED=true

# ── Observabilidad ───────────────────────────────────────────────────────────
# Logs estructurados a Axiom. SIN el token, el logger sólo escribe a stdout y
# no sale nada del VPS — es el default en desarrollo.
# AXIOM_TOKEN=
# AXIOM_DATASET=casino-api
# AXIOM_DOMAIN=api.axiom.co        # api.eu.axiom.co si la org es europea

# Salud del host: disco, memoria y carga. Sólo el disco alerta.
# Si el disco se llena, Postgres deja de escribir y el casino se cae.
# HOST_HEALTH_ENABLED=true
# HOST_HEALTH_CRON=*/15 * * * *
# HOST_HEALTH_DISK_WARN=80
# HOST_HEALTH_DISK_CRIT=90

# Canal de avisos operativos por Telegram (ver docs/13-escalabilidad.md §19).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALERT_CHAT_ID=
# ALERTS_BOOT_PING=1               # prueba del canal al arrancar; apagar después

# ── Secretos de los canales del CRM (D20) ────────────────────────────────────
# Cifra los tokens de canal —bot de Telegram, WhatsApp— antes de guardarlos en
# la base. Por D13 esos tokens son de los SOCIOS, no nuestros, y el backup de
# produccion sale del VPS todos los dias.
#
# 32 bytes en hexadecimal:  openssl rand -hex 32
#
# SIN esta variable NO se puede vincular un canal: `cifrar()` tira en vez de
# guardar texto plano. Es a proposito — un fallback silencioso no se nota hasta
# que se filtra la base.
# CHANNEL_SECRET_KEY=
#
# Solo para DESCIFRAR, durante una rotacion. Se pone la clave nueva arriba y la
# vieja aca; las filas se re-cifran a medida que se tocan. Al terminar, se saca.
# CHANNEL_SECRET_KEY_PREVIOUS=

# ── WhatsApp: el webhook de Meta (3.2, D23) ──────────────────────────────────
#
# Por D23 hay UNA App de Meta nuestra y un WABA por socio, asi que estas dos
# variables son de la plataforma, no de cada casino: se cargan una vez por
# entorno y valen para todos los numeros.
#
# El App Secret firma cada webhook entrante:
#   X-Hub-Signature-256: sha256=HMAC-SHA256(bytes crudos del body, APP SECRET)
#
# SIN esta variable el webhook RECHAZA TODO. Es a proposito: no verificar no es
# lo mismo que aceptar, y un entorno al que le falta la variable se tragaria
# cualquier cosa que le peguen a la URL, que es publica y unica para todos.
#
# D20 NO le aplica: D20 cifra los secretos de canal porque son de los socios y
# salen del VPS en el backup todas las mañanas. Este es nuestro y vive en el
# entorno, que no viaja en el dump. Lo que SI va cifrado es el token de acceso
# de cada WABA, que es del socio.
# WHATSAPP_APP_SECRET=
#
# Lo que se pone en la App de Meta al registrar la URL del webhook. Meta lo
# devuelve una sola vez, en el GET del apreton de manos.
#
# NO es una credencial de seguridad: solo prueba que quien configura la App es
# quien tiene esta variable. Lo que autentica cada mensaje es la firma de arriba.
# Cualquier string largo al azar sirve:  openssl rand -hex 24
# WHATSAPP_VERIFY_TOKEN=

# ── CRM: borrar los adjuntos vencidos (D15, roadmap 4.1) ─────────────────────
#
# El texto del chat se guarda para siempre; los adjuntos, 6 meses. El riesgo no
# esta en el texto: esta en las imagenes, que es donde viajan el DNI, el CBU y la
# cara de la gente.
#
# ⚠️ VA APAGADO POR DEFAULT, al reves que los otros crons de retencion. Los
# demas borran logs; este borra fotos que mando gente real, sin vuelta atras. Un
# proceso asi no se prende porque el contenedor arranco.
# CHAT_RETENCION_ENABLED=1
#
# Modo simulacro: recorre todo, cuenta lo que borraria y NO TOCA NADA. Conviene
# correrlo asi la primera vez sobre un historial de verdad antes de dejarlo
# borrar. Tambien sirve para ver el volumen que hay acumulado.
# CHAT_RETENCION_SIMULACRO=1
#
# Cuando corre. Default: 4 AM UTC (despues del parte diario, lejos del pico).
# CHAT_RETENCION_CRON=0 4 * * *

# ── CRM: avisarle al operador por Telegram (4.5, D25) ────────────────────────
#
# Reusa el bot de alertas (`TELEGRAM_BOT_TOKEN`, mas arriba). Lo unico nuevo es
# el secreto del webhook, que es como se verifica que un update es de Telegram
# y no de cualquiera que sepa la URL.
#
# Se genera con `openssl rand -hex 32` y se registra al hacer setWebhook:
#   curl -F "url=https://api-staging.miamihub.vip/api/v1/crm/avisos/webhook" \
#        -F "secret_token=<ESTE VALOR>" \
#        https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook
#
# ⚠️ Registrar ese webhook NO afecta el envio de alertas: mandar y recibir son
# independientes. Y sin esta variable el webhook ignora todo, asi que el vinculo
# no funciona — pero las alertas siguen llegando igual.
# TELEGRAM_ALERT_WEBHOOK_SECRET=
