# API backend URL (NestJS corre en :3000 por default).
# El web corre en :3001. Next.js rewriteá /api/* → este URL.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Host del tenant para resolver via Host header en dev.
# El backend lee el header `Host` para resolver el tenant.
# En dev usá el slug del tenant + .localhost.
NEXT_PUBLIC_TENANT_HOST=jest.localhost
