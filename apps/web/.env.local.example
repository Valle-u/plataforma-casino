# =============================================================================
# Variables de entorno para apps/web
#
# ⚠️ Las NEXT_PUBLIC_* se HORNEAN en el bundle del cliente durante `next build`.
# En Docker/Dokploy hay que pasarlas como BUILD ARGS al construir la imagen
# (ver apps/web/Dockerfile), no solo como env de runtime del contenedor.
# =============================================================================

# URL de la API (NestJS). Next reescribe /api/* → este URL. En dev, :3000.
# El browser pega same-origin a /api/*; el SSR también lee esta var en runtime.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Host del tenant para resolver via header en dev (el backend lo lee para
# resolver el tenant en tenant_domains). Provisioná el tenant con:
#   pnpm --filter @casino/db db:seed:dev-tenant
NEXT_PUBLIC_TENANT_HOST=demo.localhost

# Normalización de URLs de storage (lib/storage-url.ts). Configurables para el
# VPS; si no se setean, caen a los orígenes actuales (API en Railway + Worker).
# NEXT_PUBLIC_API_ORIGIN=https://api.tudominio.com
# NEXT_PUBLIC_WORKER_ORIGIN=https://uploads.tudominio.com

# Proxy de /storage/files → Cloudflare Worker (runtime, en next.config.ts).
# CF_WORKER_URL=https://casino-uploader.<subdominio>.workers.dev

# Kill-switch del auth server-aware / SSR del panel (Etapa 2). '1' = activo.
# SSR_AUTH=1

# ── Sentry (opcional) ────────────────────────────────────────────────────────
# Si NEXT_PUBLIC_SENTRY_DSN no está seteado, Sentry queda deshabilitado.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_ORG=<org-slug>
# SENTRY_PROJECT=<project-slug>
# SENTRY_AUTH_TOKEN=<auth-token-for-source-maps>   # 🔴 (solo build)
