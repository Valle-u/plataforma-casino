# API backend URL (NestJS corre en :3000 por default).
# El web corre en :3001. Next.js rewriteá /api/* → este URL.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Host del tenant para resolver via X-Forwarded-Host en dev.
# El backend lee este header (override del Host normal) para
# resolver el tenant en `tenant_domains` de la control DB.
#
# Para dev: provisioná el tenant con
#   pnpm --filter @casino/db db:seed:dev-tenant
# y dejá esta var en `demo.localhost`.
#
# Para usar el tenant de tests directamente, cambiá a `jest.localhost`
# (los tests E2E lo dejan en la control DB cuando corren).
NEXT_PUBLIC_TENANT_HOST=demo.localhost

# Sentry (error tracking) — opcional.
# Si NEXT_PUBLIC_SENTRY_DSN no está seteado, Sentry queda deshabilitado.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_ORG=<org-slug>
# SENTRY_PROJECT=<project-slug>
# SENTRY_AUTH_TOKEN=<auth-token-for-source-maps>
